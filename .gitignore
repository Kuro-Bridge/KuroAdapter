# build outputs (monorepo)
**/dist/

# dependencies
node_modules/

# logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# typescript build info
**/*.tsbuildinfo

# test coverage
coverage/

# Java / Gradle（platforms/je 多模块：core/、paper/ 等）
platforms/je/**/build/
platforms/je/.gradle/
platforms/je/out/

# 嵌入式打包产物（构建期生成，gitignore）
platforms/je/paper/src/main/resources/embedded/

# scripts/embed.ts 的 node dist 下载缓存
.cache/

# 运行产物（沙盒）
sandbox/

# OS / IDE
.DS_Store
.idea/
.vscode/*.local.json
.vscode/*.code-workspace

# Visual Studio
*.suo
*.ntvs*
*.njsproj
*.sln

# QQ 运行产物（登录态数据库，勿提交）
*.db
bridge/embedded/plugins/
