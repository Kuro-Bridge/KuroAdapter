{
    "$schema": "https://biomejs.dev/schemas/2.5.7/schema.json",
    "vcs": {
        "enabled": true,
        "clientKind": "git",
        "useIgnoreFile": true
    },
    "files": {
        "ignoreUnknown": false,
        "includes": [
            "bridge/**/src/**/*.{ts,tsx,mts,cts,js,mjs,cjs,jsx}",
            "platforms/be/**/*.{ts,tsx,mts,cts,js,mjs,cjs,jsx}",
            "scripts/**/*.{ts,js,mjs}"
        ]
    },
    "formatter": {
        "enabled": true,
        "indentStyle": "space",
        "indentWidth": 4,
        "lineWidth": 100
    },
    "linter": {
        "enabled": true,
        "rules": {
            "preset": "recommended",
            "correctness": {
                "noUnresolvedImports": "off",
                "noUnusedPrivateClassMembers": "error"
            },
            "complexity": {
                "useLiteralKeys": "off",
                "noUselessUndefinedInitialization": "error",
                "noForEach": "error",
                "noExcessiveCognitiveComplexity": {
                    "level": "error",
                    "options": {
                        "maxAllowedComplexity": 15
                    }
                }
            },
            "style": {
                "useNamingConvention": {
                    "level": "error",
                    "options": {
                        "strictCase": false,
                        "conventions": [
                            {
                                "selector": {
                                    "kind": "typeParameter"
                                },
                                "formats": ["PascalCase"]
                            },
                            {
                                "selector": {
                                    "kind": "typeMember"
                                },
                                "formats": ["camelCase", "snake_case", "PascalCase"]
                            },
                            {
                                "selector": {
                                    "kind": "objectLiteralMember"
                                },
                                "formats": ["camelCase", "snake_case", "CONSTANT_CASE"]
                            }
                        ]
                    }
                },
                "useImportType": "error",
                "noRestrictedImports": {
                    "level": "error",
                    "options": {
                        "patterns": [
                            {
                                "group": ["**/protocol/src/**", "**/protocol/dist/**"],
                                "message": "协议类型与值只许经包名入口 @kuro-bridge/protocol 导入（ADR-008/031/035）；深路径直入 node_modules 产物越过包 exports 边界"
                            }
                        ]
                    }
                },
                "useDefaultParameterLast": "error",
                "useConsistentArrayType": "error",
                "useArrayLiterals": "error",
                "noParameterProperties": "error",
                "useNodeAssertStrict": "error",
                "useFilenamingConvention": {
                    "level": "error",
                    "options": {
                        "filenameCases": ["camelCase", "kebab-case"]
                    }
                }
            },
            "suspicious": {
                "noEmptyBlockStatements": "error",
                "useErrorMessage": "error",
                "noSkippedTests": "error",
                "noConsole": {
                    "level": "error",
                    "options": {
                        "allow": ["log"]
                    }
                }
            },
            "performance": {
                "noAccumulatingSpread": "error",
                "useTopLevelRegex": "error",
                "noReExportAll": "error"
            },
            "nursery": {
                "noFloatingPromises": "error"
            }
        }
    },
    "overrides": [
        {
            "includes": ["scripts/**"],
            "linter": {
                "rules": {
                    "suspicious": {
                        "noConsole": "off"
                    }
                }
            }
        },
        {
            "includes": ["**/*.test.ts", "**/*.test.tsx", "**/*.spec.ts", "**/__tests__/**"],
            "linter": {
                "rules": {
                    "performance": {
                        "useTopLevelRegex": "off"
                    }
                }
            }
        }
    ],
    "javascript": {
        "formatter": {
            "quoteStyle": "double",
            "semicolons": "always",
            "trailingCommas": "all"
        }
    },
    "assist": {
        "enabled": true,
        "actions": {
            "source": {
                "organizeImports": "on"
            }
        }
    }
}
