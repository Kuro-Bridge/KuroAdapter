{
    "$schema": "https://json.schemastore.org/package.json",
    "name": "kurobridge",
    "version": "0.1.0",
    "description": "MC 服务器 ↔ 社交平台群服互通插件",
    "type": "module",
    "private": true,
    "license": "MIT",
    "keywords": [
        "minecraft",
        "paper",
        "websocket",
        "napukettoqq",
        "群服互通"
    ],
    "scripts": {
        "build": "pnpm -r build",
        "lint": "biome lint .",
        "format": "biome format --write .",
        "check": "pnpm -r build && biome check . && tsc --noEmit && tsc --noEmit -p platforms/be/lse && pnpm check:docs && pnpm check:versions",
        "check:docs": "node scripts/check-docs-scope.mjs && node scripts/check-docs-links.mjs",
        "check:versions": "node scripts/check-versions.mjs",
        "fix": "biome check --write . && tsc --noEmit",
        "test": "vitest run",
        "test:watch": "vitest",
        "test:coverage": "vitest run --coverage",
        "build:jar": "node scripts/build-jar.mjs"
    },
    "devEngines": {
        "packageManager": {
            "name": "pnpm",
            "version": "11.6.0",
            "onFail": "download"
        }
    },
    "engines": {
        "node": ">=26",
        "pnpm": ">=11"
    },
    "devDependencies": {
        "@biomejs/biome": "^2.5.6",
        "@types/node": "^26.1.2",
        "@vitest/coverage-v8": "^4.1.10",
        "lefthook": "^1.7.0",
        "typescript": "^7.0.2",
        "vitest": "^4.1.10"
    }
}