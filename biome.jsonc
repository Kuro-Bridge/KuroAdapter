{
    "$schema": "https://biomejs.dev/schemas/2.5.14/schema.json",
    "vcs": {
        "enabled": true,
        "clientKind": "git",
        "useIgnoreFile": true
    },
    "files": {
        "ignoreUnknown": false,
        "includes": [
            "bridge/**/src/**/*.{ts,tsx,mts,cts,js,mjs,cjs,jsx}",
            "bridge/**/stub/**/*.mjs",
            "platforms/be/**/*.{ts,tsx,mts,cts,js,mjs,cjs,jsx}",
            "toolings/**/*.{ts,js,mjs}"
        ]
    },
    "formatter": {
        "enabled": true,
        "indentStyle": "space",
        "indentWidth": 4,
        "lineWidth": 100
    },
    "linter": {
        "enabled": true,
        "rules": {
            "preset": "recommended",
            "correctness": {
                "noUnresolvedImports": "off",
                "noUnusedPrivateClassMembers": "error"
            },
            "complexity": {
                "useLiteralKeys": "off",
                "noUselessUndefinedInitialization": "error",
                "noForEach": "error",
                "noExcessiveCognitiveComplexity": {
                    "level": "error",
                    "options": {
                        "maxAllowedComplexity": 15
                    }
                }
            },
            "style": {
                "useNamingConvention": {
                    "level": "error",
                    "options": {
                        "strictCase": false,
                        "conventions": [
                            {
                                "selector": {
                                    "kind": "typeParameter"
                                },
                                "formats": ["PascalCase"]
                            },
                            {
                                "selector": {
                                    "kind": "typeMember"
                                },
                                "formats": ["camelCase", "snake_case", "PascalCase"]
                            },
                            {
                                "selector": {
                                    "kind": "objectLiteralMember"
                                },
                                "formats": ["camelCase", "snake_case", "CONSTANT_CASE"]
                            }
                        ]
                    }
                },
                "useImportType": "error",
                "noRestrictedImports": {
                    "level": "error",
                    "options": {
                        "patterns": [
                            {
                                "group": ["**/protocol/src/**", "**/protocol/dist/**"],
                                "message": "协议类型与值只许经包名入口 @kuro-bridge/protocol 导入（ADR-008/031/035）；深路径直入 node_modules 产物越过包 exports 边界"
                            }
                        ]
                    }
                },
                "useDefaultParameterLast": "error",
                "useConsistentArrayType": "error",
                "useArrayLiterals": "error",
                "noParameterProperties": "error",
                "useNodeAssertStrict": "error",
                "useFilenamingConvention": {
                    "level": "error",
                    "options": {
                        "filenameCases": ["camelCase", "kebab-case"]
                    }
                }
            },
            "suspicious": {
                "noEmptyBlockStatements": "error",
                "useErrorMessage": "error",
                "noSkippedTests": "error",
                "noConsole": {
                    "level": "error",
                    "options": {
                        "allow": ["log"]
                    }
                }
            },
            "performance": {
                "noAccumulatingSpread": "error",
                "useTopLevelRegex": "error",
                "noReExportAll": "error"
            },
            "nursery": {
                "noFloatingPromises": "error"
            }
        }
    },
    "overrides": [
        {
            "includes": ["toolings/**"],
            "linter": {
                "rules": {
                    "suspicious": {
                        "noConsole": "off"
                    }
                }
            }
        },
        {
            // 白名单（批次 2026-09-19-modernize，基线 §10 终裁 2：扩面暴露的重构级违例逐条
            // 入册、本波零重构）。stub/peer.mjs 为 JAR 内嵌运行时脚本（384 行，决策 D-06
            // 沙盒验收端），拆函数触碰发布物字节，超出「零行为变更」红线授权面。逐条：
            // - runAutoSequence：复杂度 24（env 驱动的验收自动化序列，三分支各自循环+跳过）
            // - handleLine：复杂度 18（stdin 交互命令三分发，各带用法校验）
            // - connect 的 message 监听器：复杂度 23（协议帧逐类型分发，hello_ack 分支嵌套）
            // 域内其余规则（格式、noConsole 等）全量生效，仅豁免本条重构级规则。
            "includes": ["bridge/**/stub/**/*.mjs"],
            "linter": {
                "rules": {
                    "complexity": {
                        "noExcessiveCognitiveComplexity": "off"
                    }
                }
            }
        },
        {
            "includes": ["**/*.test.ts", "**/*.test.tsx", "**/*.spec.ts", "**/__tests__/**"],
            "linter": {
                "rules": {
                    "performance": {
                        "useTopLevelRegex": "off"
                    }
                }
            }
        }
    ],
    "javascript": {
        "formatter": {
            "quoteStyle": "double",
            "semicolons": "always",
            "trailingCommas": "all"
        }
    },
    "assist": {
        "enabled": true,
        "actions": {
            "source": {
                "organizeImports": "on"
            }
        }
    }
}
