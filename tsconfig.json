{
    "$schema": "https://json.schemastore.org/tsconfig",
    "compilerOptions": {
        "target": "ES2020",
        "module": "NodeNext",
        "moduleResolution": "NodeNext",
        "moduleDetection": "force",
        "lib": [
            "ES2020"
        ],
        "types": [
            "node"
        ],
        "strict": true,
        "noImplicitAny": true,
        "strictNullChecks": true,
        "strictFunctionTypes": true,
        "strictBindCallApply": true,
        "strictPropertyInitialization": true,
        "noImplicitThis": true,
        "alwaysStrict": true,
        "noUncheckedIndexedAccess": true,
        "noPropertyAccessFromIndexSignature": true,
        "exactOptionalPropertyTypes": true,
        "noUnusedLocals": true,
        "noUnusedParameters": true,
        "noImplicitReturns": true,
        "noFallthroughCasesInSwitch": true,
        "noImplicitOverride": true,
        "allowUnreachableCode": false,
        "allowUnusedLabels": false,
        "verbatimModuleSyntax": true,
        "isolatedModules": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "forceConsistentCasingInFileNames": true,
        "declaration": true,
        "declarationMap": true,
        "noEmit": true,
        "allowImportingTsExtensions": true,
        "erasableSyntaxOnly": true
    },
    // 根检查配置（pnpm check 的 tsc --noEmit 用）：显式白名单，只查 TS 包源码。
    // 特殊环境（如 platforms/be/lse 的 QuickJS、未来的 C++ 薄壳）用各自 tsconfig，不进此范围。
    // vitest.config.ts 为根目录 config ts（与 KuroProtocol 对齐口径，基线 §2.1/§2.4 收编）。
    "include": [
        "bridge/*/src",
        // 开发/沙盒用 stub 协议端（node 直接跑 peer.ts）
        "bridge/*/stub",
        // toolings 全部 TS 脚本与单测（含 gates / build / packaging / paper）
        "toolings/**/*.ts",
        // Endstone C++ 集成测试的 Node 桩
        "platforms/be/endstone/tests/fixtures/*.ts",
        "vitest.config.ts"
    ]
}